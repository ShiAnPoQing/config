'ttytype'         'tty'     'term' 的别名
'undodir'         'udir'    存储撤销文件的位置
'undofile'        'udf'     将撤销信息保存在文件中
'undolevels'      'ul'      可以撤销的最大更改次数
'undoreload'      'ur'      重新加载缓冲区时为撤销保存的最大行数
'updatecount'     'uc'      刷新交换文件的字符数
'updatetime'      'ut'      刷新交换文件的毫秒数
'varsofttabstop'  'vsts'    软制表位之间列数的列表
'vartabstop'      'vts'     制表位之间列数的列表
'verbose'         'vbs'     提供信息性消息
